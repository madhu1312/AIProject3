# JIRA Configuration
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-api-token-here
JIRA_PROJECT_KEY=CMS

# OpenAI Configuration (for Laddr agents)
OPENAI_API_KEY=your-openai-api-key

# Project Paths
CMS_APP_PATH=../
CMS_SRC_PATH=../src
CMS_TESTS_PATH=../tests

# Pipeline Configuration
AUTO_CREATE_JIRA_TICKETS=true
AUTO_WRITE_CODE=true
AUTO_WRITE_TESTS=true
